#include <stdio.h>

// Basic Level character 'A' Pattern
void basicLevelPatternA(int rowColNumber)
{
    for (int row = 0; row < rowColNumber; row++)
    {
        for (int col = 0; col < rowColNumber; col++)
        {
            if (row == 0 || col == 0 || col == rowColNumber - 1 || row == rowColNumber / 2)
            {
                printf("*");
            }
            else
            {
                printf(" ");
            }
        }
        printf("\n");
    }
}

